[Unit]
Description=CyCloud Container Access Control API
After=network.target docker.service
Requires=docker.service

[Service]
Type=exec
User=root
Group=root

Environment="SCRIPTS_DIR=/opt/container-management"
Environment="LOG_FILE=/var/log/container-access-api.log"

NoNewPrivileges=false
PrivateTmp=true

Restart=always
RestartSec=10
StartLimitInterval=300
StartLimitBurst=5

LimitNOFILE=65536
MemoryMax=512M
CPUQuota=50%

ExecStartPre=/bin/mkdir -p /var/run /var/log /var/lib/container-access-api /var/lib/container-ssh-mappings
ExecStartPre=/bin/chmod 755 /opt/container-management/cycloud_container_access_control_api.sh
ExecStart=/opt/container-management/cycloud_container_access_control_api.sh
ExecReload=/bin/kill -HUP $MAINPID

StandardOutput=journal
StandardError=journal
SyslogIdentifier=container-access-api

[Install]
WantedBy=multi-user.target